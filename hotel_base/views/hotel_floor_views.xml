<odoo>
    <record id="hotel_floor_view_list" model="ir.ui.view">
        <field name="name">hotel.floor.list</field>
        <field name="model">hotel.floor</field>
        <field name="arch" type="xml">
            <list string="Floors">
                <field name="sequence"/>
                <field name="code"/>
                <field name="name"/>
                <field name="property_id"/>
                <field name="building_id"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="hotel_floor_view_form" model="ir.ui.view">
        <field name="name">hotel.floor.form</field>
        <field name="model">hotel.floor</field>
        <field name="arch" type="xml">
            <form string="Floor">
                <sheet>
                    <group>
                        <group>
                            <field name="property_id"/>
                            <field name="building_id"/>
                            <field name="company_id" readonly="1"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hotel_floor_view_search" model="ir.ui.view">
        <field name="name">hotel.floor.search</field>
        <field name="model">hotel.floor</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="property_id"/>
                <field name="building_id"/>
                <field name="company_id"/>
                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Property" name="group_by_property" context="{'group_by': 'property_id'}"/>
                <filter string="Building" name="group_by_building" context="{'group_by': 'building_id'}"/>
            </search>
        </field>
    </record>

    <record id="hotel_floor_action" model="ir.actions.act_window">
        <field name="name">Floors</field>
        <field name="res_model">hotel.floor</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hotel_floor_view_search"/>
        <field name="context">{}</field>
    </record>
</odoo>