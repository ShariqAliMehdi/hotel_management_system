<odoo>
    <record id="hotel_tax_view_list" model="ir.ui.view">
        <field name="name">hotel.tax.list</field>
        <field name="model">hotel.tax</field>
        <field name="arch" type="xml">
            <list string="Hotel Taxes">
                <field name="name"/>
                <field name="company_id"/>
                <field name="amount_type"/>
                <field name="amount"/>
                <field name="price_include"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="hotel_tax_view_form" model="ir.ui.view">
        <field name="name">hotel.tax.form</field>
        <field name="model">hotel.tax</field>
        <field name="arch" type="xml">
            <form string="Hotel Tax">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="amount_type"/>
                            <field name="amount"/>
                            <field name="price_include"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hotel_tax_view_search" model="ir.ui.view">
        <field name="name">hotel.tax.search</field>
        <field name="model">hotel.tax</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="company_id"/>
                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="hotel_tax_action" model="ir.actions.act_window">
        <field name="name">Hotel Taxes</field>
        <field name="res_model">hotel.tax</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hotel_tax_view_search"/>
        <field name="context">{}</field>
    </record>
</odoo>