<odoo>
    <record id="hotel_tax_view_tree" model="ir.ui.view">
        <field name="name">hotel.tax.list</field>
        <field name="model">hotel.tax</field>
        <field name="arch" type="xml">
            <list string="Hotel Taxes">
                <field name="name"/>
                <field name="company_id"/>
                <field name="tax_amount_type"/>
                <field name="amount"/>
                <field name="include_in_rate"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="hotel_tax_view_form" model="ir.ui.view">
        <field name="name">hotel.tax.form</field>
        <field name="model">hotel.tax</field>
        <field name="arch" type="xml">
            <form string="Hotel Tax">
                <header>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <group>
                        <field name="company_id" required="1"/>
                        <field name="name" required="1"/>
                        <field name="tax_amount_type" required="1"/>
                        <field name="amount"/>
                        <field name="include_in_rate"/>
                        <field name="currency_id" readonly="1"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hotel_tax_search" model="ir.ui.view">
        <field name="name">hotel.tax.search</field>
        <field name="model">hotel.tax</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="company_id"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>
</odoo>