<odoo>
    <record id="hotel_building_view_tree" model="ir.ui.view">
        <field name="name">hotel.building.list</field>
        <field name="model">hotel.building</field>
        <field name="arch" type="xml">
            <list string="Buildings">
                <field name="name"/>
                <field name="property_id"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="hotel_building_view_form" model="ir.ui.view">
        <field name="name">hotel.building.form</field>
        <field name="model">hotel.building</field>
        <field name="arch" type="xml">
            <form string="Building">
                <header>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <group>
                        <field name="property_id" required="1"/>
                        <field name="name" required="1"/>
                        <field name="code"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Floors">
                            <field name="floor_ids" context="{'default_property_id': property_id}"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hotel_building_search" model="ir.ui.view">
        <field name="name">hotel.building.search</field>
        <field name="model">hotel.building</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="property_id"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>
</odoo>