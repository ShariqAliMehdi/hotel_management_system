<odoo>
    <record id="res_company_form_hotel_base_inherit" model="ir.ui.view">
        <field name="name">res.company.form.hotel.base.inherit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Hotel Defaults">
                    <group>
                        <field name="hotel_default_currency_id"/>
                        <field name="hotel_default_tax_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>