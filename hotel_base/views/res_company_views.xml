<odoo>
    <record id="res_company_view_form_hotel_base" model="ir.ui.view">
        <field name="name">res.company.form.hotel.base</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Hotel">
                    <group>
                        <field name="hotel_default_property_id" domain="[('company_id', '=', id)]"/>
                    </group>
                    <group>
                        <field name="hotel_property_ids" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>