<odoo>
    <record id="hotel_amenity_view_tree" model="ir.ui.view">
        <field name="name">hotel.amenity.list</field>
        <field name="model">hotel.amenity</field>
        <field name="arch" type="xml">
            <list string="Amenities">
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="hotel_amenity_view_form" model="ir.ui.view">
        <field name="name">hotel.amenity.form</field>
        <field name="model">hotel.amenity</field>
        <field name="arch" type="xml">
            <form string="Amenity">
                <header>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" required="1"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hotel_amenity_search" model="ir.ui.view">
        <field name="name">hotel.amenity.search</field>
        <field name="model">hotel.amenity</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>
</odoo>