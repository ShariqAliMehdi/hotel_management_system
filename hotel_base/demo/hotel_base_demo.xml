<odoo noupdate="1">
    <record id="hotel_base_demo_property" model="hotel.property">
        <field name="company_id" ref="base.main_company"/>
        <field name="name">Grand Aurora</field>
        <field name="code">AURORA</field>
        <field name="email">reservations@grandaurora.example</field>
        <field name="phone">+1 555 0100</field>
        <field name="address">123 Aurora Avenue, Cityville</field>
        <field name="default_checkin_time">14.0</field>
        <field name="default_checkout_time">11.0</field>
    </record>

    <record id="hotel_base_demo_building_a" model="hotel.building">
        <field name="property_id" ref="hotel_base_demo_property"/>
        <field name="name">Main Building</field>
        <field name="code">MAIN</field>
    </record>

    <record id="hotel_base_demo_floor_1" model="hotel.floor">
        <field name="property_id" ref="hotel_base_demo_property"/>
        <field name="building_id" ref="hotel_base_demo_building_a"/>
        <field name="name">Floor 1</field>
        <field name="sequence">10</field>
    </record>

    <record id="hotel_base_demo_amenity_wifi" model="hotel.amenity">
        <field name="name">Free Wi-Fi</field>
        <field name="description">High speed internet access in all rooms and common areas.</field>
    </record>

    <record id="hotel_base_demo_amenity_breakfast" model="hotel.amenity">
        <field name="name">Breakfast Included</field>
        <field name="description">Daily breakfast for registered guests.</field>
    </record>

    <record id="hotel_base_demo_room_type_standard" model="hotel.room.type">
        <field name="property_id" ref="hotel_base_demo_property"/>
        <field name="name">Standard</field>
        <field name="code">STD</field>
        <field name="capacity_adults">2</field>
        <field name="capacity_children">1</field>
        <field name="base_rate">120.0</field>
        <field name="amenity_ids" eval="[(6,0,[ref('hotel_base_demo_amenity_wifi'), ref('hotel_base_demo_amenity_breakfast')])]" />
        <field name="description">&lt;p&gt;Comfortable rooms for city breaks.&lt;/p&gt;</field>
    </record>

    <record id="hotel_base_demo_tax_city_tax" model="hotel.tax">
        <field name="company_id" ref="base.main_company"/>
        <field name="name">City Tax</field>
        <field name="tax_amount_type">percent</field>
        <field name="amount">5.0</field>
        <field name="include_in_rate">False</field>
    </record>

    <record id="hotel_base_demo_season_peak" model="hotel.seasonal.calendar">
        <field name="property_id" ref="hotel_base_demo_property"/>
        <field name="name">Peak Season</field>
        <field name="season_type">peak</field>
        <field name="date_from">2026-06-01</field>
        <field name="date_to">2026-08-31</field>
    </record>
</odoo>