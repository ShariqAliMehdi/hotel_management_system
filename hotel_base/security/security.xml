<odoo>
    <record id="hotel_base_module_category" model="ir.module.category">
        <field name="name">Hotel Management</field>
        <field name="sequence">30</field>
    </record>

    <record id="hotel_base_privilege_user" model="res.groups.privilege">
        <field name="name">Hotel User</field>
        <field name="category_id" ref="hotel_base_module_category"/>
        <field name="sequence">10</field>
    </record>

    <record id="hotel_base_privilege_manager" model="res.groups.privilege">
        <field name="name">Hotel Manager</field>
        <field name="category_id" ref="hotel_base_module_category"/>
        <field name="sequence">20</field>
    </record>

    <record id="group_hotel_base_user" model="res.groups">
        <field name="name">Hotel User</field>
        <field name="privilege_id" ref="hotel_base_privilege_user"/>
    </record>

    <record id="group_hotel_base_manager" model="res.groups">
        <field name="name">Hotel Manager</field>
        <field name="privilege_id" ref="hotel_base_privilege_manager"/>
        <field name="implied_ids" eval="[(4, ref('hotel_base.group_hotel_base_user'))]"/>
    </record>

    <record id="hotel_property_rule_user" model="ir.rule">
        <field name="name">Hotel Property Company Rule</field>
        <field name="model_id" ref="model_hotel_property"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('hotel_base.group_hotel_base_user'))]"/>
    </record>

    <record id="hotel_building_rule_user" model="ir.rule">
        <field name="name">Hotel Building Company Rule</field>
        <field name="model_id" ref="model_hotel_building"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('hotel_base.group_hotel_base_user'))]"/>
    </record>

    <record id="hotel_floor_rule_user" model="ir.rule">
        <field name="name">Hotel Floor Company Rule</field>
        <field name="model_id" ref="model_hotel_floor"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('hotel_base.group_hotel_base_user'))]"/>
    </record>

    <record id="hotel_room_category_rule_user" model="ir.rule">
        <field name="name">Hotel Room Category Company Rule</field>
        <field name="model_id" ref="model_hotel_room_category"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('hotel_base.group_hotel_base_user'))]"/>
    </record>

    <record id="hotel_tax_rule_user" model="ir.rule">
        <field name="name">Hotel Tax Company Rule</field>
        <field name="model_id" ref="model_hotel_tax"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('hotel_base.group_hotel_base_user'))]"/>
    </record>

    <record id="hotel_season_rule_user" model="ir.rule">
        <field name="name">Hotel Season Company Rule</field>
        <field name="model_id" ref="model_hotel_season"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('hotel_base.group_hotel_base_user'))]"/>
    </record>
</odoo>